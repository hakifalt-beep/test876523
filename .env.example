# VPN Server Configuration
VPN_SERVER=vpn.example.com
VPN_PORT=1194
VPN_PROTOCOL=wireguard

# User Authentication
VPN_USERNAME=your_username
VPN_PASSWORD=your_password

# Auto-Connect Settings
AUTO_CONNECT=true
AUTO_RECONNECT=true
RECONNECT_INTERVAL=5000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/vpn-client.log
